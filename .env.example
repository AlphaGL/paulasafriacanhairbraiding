# Copy this file to .env and fill in real values. Never commit the real .env file.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Postgres connection string (Neon, Supabase, or any Postgres host works the same way).
# Neon: dashboard -> Connection Details -> copy the "postgresql://..." string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cloudinary — find these in your Cloudinary dashboard home page
# (either set the single CLOUDINARY_URL, or the three separate values below)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Gmail example — see README for how to create an "App Password")
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=Pauletteagbeti@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=Pauletteagbeti@gmail.com
BUSINESS_NOTIFICATION_EMAIL=Pauletteagbeti@gmail.com
